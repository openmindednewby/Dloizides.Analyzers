<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Meziantou.Analyzer" Version="$(MeziantouAnalyzerVersion)" GeneratePathProperty="true" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="$(ThreadingAnalyzersVersion)" GeneratePathProperty="true" ExcludeAssets="all" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="$(SonarAnalyzerVersion)" GeneratePathProperty="true" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dloizides.Analyzers\Dloizides.Analyzers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="MeziantouPath" Value="$(PkgMeziantou_Analyzer)" />
    <AssemblyMetadata Include="ThreadingPath" Value="$(PkgMicrosoft_VisualStudio_Threading_Analyzers)" />
    <AssemblyMetadata Include="SonarPath" Value="$(PkgSonarAnalyzer_CSharp)" />
    <AssemblyMetadata Include="BuildTransitivePath" Value="$(MSBuildThisFileDirectory)..\..\src\Dloizides.Analyzers\buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <Import Project="../../src/Dloizides.Analyzers/buildTransitive/Dloizides.Analyzers.targets" />

</Project>

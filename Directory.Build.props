<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <Authors>DLoizides</Authors>
    <Company>dloizides.com</Company>
    <PackageProjectUrl>https://github.com/openmindednewby/Dloizides.Analyzers</PackageProjectUrl>
    <RepositoryUrl>https://github.com/openmindednewby/Dloizides.Analyzers</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>roslyn;analyzer;comments;code-style;documentation;xml-doc;testing;naming</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Roslyn analyzers for a no-comments code style: DLZ0001 bans line/block comments, DLZ0002 allows doc comments only on public/protected members, DLZ0003 caps a doc comment at 3 lines of summary/param/returns, DLZ0004 requires Method_Scenario_Expected test names, DLZ0005 reports types in Services/Helpers/Utils/Utilities/Common namespaces.</Description>

    <Version>0.4.0</Version>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <FileVersion>0.4.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Condition="Exists('$(MSBuildThisFileDirectory)README.md')" />
  </ItemGroup>
</Project>





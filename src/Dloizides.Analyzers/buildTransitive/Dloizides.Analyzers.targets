  <Target Name="DloizidesNarrowOptionsAsErrors" BeforeTargets="CoreCompile" Condition="'$(DloizidesBaselinedRulesAsErrors)' == 'true'">
    <ItemGroup>
      <_DloizidesNarrowOptionsBaseline Include="@(AdditionalFiles)" Condition="Exists('%(FullPath)') And '%(Filename)%(Extension)' == 'narrow-options-baseline.txt'" />
    </ItemGroup>
    <PropertyGroup Condition="'@(_DloizidesNarrowOptionsBaseline)' != ''">
      <WarningsNotAsErrors>$(WarningsNotAsErrors.Replace(';DLZ0033', '').Replace(';DLZ0019', '').Replace(';DLZ0027', ''))</WarningsNotAsErrors>

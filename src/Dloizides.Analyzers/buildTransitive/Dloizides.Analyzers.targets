    <PropertyGroup Condition="'@(_DloizidesSealedRecordBaseline)' != ''">
      <WarningsNotAsErrors>$(WarningsNotAsErrors.Replace(';DLZ0029', '').Replace(';DLZ0019', '').Replace(';DLZ0027', ''))</WarningsNotAsErrors>
      <WarningsAsErrors>$(WarningsAsErrors);DLZ0029;DLZ0019;DLZ0027</WarningsAsErrors>

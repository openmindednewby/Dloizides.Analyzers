    <PropertyGroup Condition="'@(_DloizidesReadOnlyParameterBaseline)' != ''">
      <WarningsNotAsErrors>$(WarningsNotAsErrors.Replace(';DLZ0034', '').Replace(';DLZ0019', '').Replace(';DLZ0027', ''))</WarningsNotAsErrors>
      <WarningsAsErrors>$(WarningsAsErrors);DLZ0034;DLZ0019;DLZ0027</WarningsAsErrors>
    </PropertyGroup>
  </Target>
  <Target Name="DloizidesServiceDefaultsGuardAsErrors" BeforeTargets="CoreCompile" Condition="'$(DloizidesEnableServiceDefaultsGuardErrors)' == 'true'">
    <PropertyGroup>
      <WarningsNotAsErrors>$(WarningsNotAsErrors.Replace(';DLZ0021', ''))</WarningsNotAsErrors>
      <WarningsAsErrors>$(WarningsAsErrors);DLZ0021</WarningsAsErrors>
    </PropertyGroup>
  </Target>
</Project>
